# Tạo file .env từ file này: cp .env.example .env
# App (qua spring.config.import) và Docker Compose cùng đọc .env.
# Chỉ dùng các key bên dưới, viết giá trị không có dấu nháy.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_analytics
DB_USERNAME=social
DB_PASSWORD=social
# Chỉ Docker Compose dùng, để tạo tài khoản root của MySQL
DB_ROOT_PASSWORD=root

PORT=8080
# Chạy sau reverse proxy/load balancer (proxy kết thúc HTTPS) thì đặt native, để header Location dùng
# scheme và tên miền public từ X-Forwarded-*. Chạy local thì để trống.
FORWARD_HEADERS_STRATEGY=

# Múi giờ nghiệp vụ: dùng để tính "hôm nay" và ngày trong báo cáo. DB luôn lưu UTC.
APP_TIME_ZONE=Asia/Ho_Chi_Minh

# Mật khẩu hai tài khoản demo của profile dev (đăng nhập ở /login): demo-admin (ADMIN) và demo-user (USER).
# Bắt buộc khi chạy profile dev, tối thiểu 8 ký tự; profile khác không dùng.
APP_DEMO_ADMIN_PASSWORD=
APP_DEMO_USER_PASSWORD=

# dev: bật Swagger UI, form đăng nhập demo và tạo dữ liệu mẫu khi DB còn trống. Khi deploy thì không đặt biến này.
SPRING_PROFILES_ACTIVE=dev
