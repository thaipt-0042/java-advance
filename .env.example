# Tạo file .env từ file này: cp .env.example .env
# App (qua spring.config.import) và Docker Compose cùng đọc .env.
# Chỉ dùng các key bên dưới, viết giá trị không có dấu nháy.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_analytics
DB_USERNAME=social
DB_PASSWORD=social
# Chỉ Docker Compose dùng, để tạo tài khoản root của MySQL
DB_ROOT_PASSWORD=root

PORT=8080

# dev: bật Swagger UI và cho Hibernate tự cập nhật schema. Khi deploy thì không đặt biến này.
SPRING_PROFILES_ACTIVE=dev
