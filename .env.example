# Tạo file .env từ file này: cp .env.example .env
# App (qua spring.config.import) và Docker Compose cùng đọc .env.
# Chỉ dùng các key bên dưới, viết giá trị không có dấu nháy.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_analytics
DB_USERNAME=social
DB_PASSWORD=social
# Chỉ Docker Compose dùng, để tạo tài khoản root của MySQL
DB_ROOT_PASSWORD=root

PORT=8080
# Chạy sau reverse proxy/load balancer (proxy kết thúc HTTPS) thì đặt native, để header Location dùng
# scheme và tên miền public từ X-Forwarded-*. Chạy local thì để trống.
FORWARD_HEADERS_STRATEGY=

# Múi giờ nghiệp vụ: dùng để tính "hôm nay" và ngày trong báo cáo. DB luôn lưu UTC.
APP_TIME_ZONE=Asia/Ho_Chi_Minh

# Broker JMS (Apache Artemis, trước đây là ActiveMQ Artemis) chạy bằng Docker Compose; app và broker cùng đọc.
ARTEMIS_HOST=localhost
ARTEMIS_PORT=61616
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis

# Job cập nhật số liệu: lịch chạy (cron 6 trường của Spring, theo APP_TIME_ZONE; "-" để tắt) và số luồng chạy song
# song (phải nhỏ hơn số kết nối DB, mặc định 10).
METRICS_JOB_CRON=0 0 * * * *
METRICS_JOB_THREADS=4

# Đăng nhập bằng Facebook / X: điền cả id và secret của app tạo trên trang developer (để trống = tắt provider đó).
# Callback cần khai báo ở app: <địa chỉ app>/login/oauth2/code/facebook và .../login/oauth2/code/twitter.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Khóa mã hóa token khi lưu (bắt buộc khi bật provider nào đó): openssl rand -base64 32
APP_TOKEN_ENCRYPTION_KEY=
# Tài khoản được ADMIN khi đăng nhập, dạng FACEBOOK:<id>,TWITTER:<id>; còn lại là USER.
APP_ADMIN_ACCOUNTS=

# Mật khẩu hai tài khoản demo của profile dev (đăng nhập ở /login): demo-admin (ADMIN) và demo-user (USER).
# Bắt buộc khi chạy profile dev, tối thiểu 8 ký tự; profile khác không dùng.
APP_DEMO_ADMIN_PASSWORD=
APP_DEMO_USER_PASSWORD=

# dev: bật Swagger UI, form đăng nhập demo và tạo dữ liệu mẫu khi DB còn trống. Khi deploy thì không đặt biến này.
SPRING_PROFILES_ACTIVE=dev
